@page
@model WuphfWeb.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="wuphf-container">
    <h2 class="mb-4">🛠️ Admin Console</h2>

    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <h4>Search Users</h4>
        </div>
        <div class="card-body">
            <form class="form-inline" id="userSearchForm">
                <input type="text" id="userSearchInput" class="form-control mr-2" placeholder="Search by username..." />
                <button type="button" id="userSearchBtn" class="btn btn-primary">Search</button>
            </form>
            <div id="userSearchResults" class="mt-3"></div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <h4>Registered Users</h4>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Wuphfs Sent</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.Username</td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>
                            <td>@user.WuphfsSent</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-info text-white">
            <h4>All WUPHFs</h4>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Author</th>
                        <th>Content</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var wuphf in Model.AllWuphfs)
                    {
                        <tr>
                            <td>@wuphf.Id</td>
                            <td>@wuphf.AuthorName</td>
                            <td>@wuphf.Content</td>
                            <td>@wuphf.CreatedAt</td>
                            <td>
                                <button class="btn btn-sm btn-danger" onclick="deleteWuphf(@wuphf.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('userSearchBtn').addEventListener('click', async () => {
            const query = document.getElementById('userSearchInput').value;
            const response = await fetch(`/Admin/SearchUsers?query=${query}`);
            const results = await response.json();
            const container = document.getElementById('userSearchResults');
            container.innerHTML = results.map(u => `<div>${u.username} - ${u.email}</div>`).join('');
        });

        async function deleteWuphf(id) {
            await fetch(`/Admin/DeleteWuphf?id=${id}`, { method: 'POST' });
            location.reload();
        }
    </script>
}
