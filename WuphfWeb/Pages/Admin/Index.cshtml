@page
@model WuphfWeb.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>WUPHF Admin</h1>
        <p class="text-muted mb-0">Community overview and account management</p>
    </div>
    <form method="post" asp-page-handler="SignOut">
        <button class="btn btn-outline-secondary" type="submit">Sign out</button>
    </form>
</div>

<div class="row mb-4">
    <div class="col-md-6"><div class="stat-card"><h3>@Model.Users.Count</h3><p>Accounts shown</p></div></div>
    <div class="col-md-6"><div class="stat-card"><h3>@Model.WuphfCount</h3><p>WUPHFs</p></div></div>
</div>

<div class="card">
    <div class="card-header"><h2 class="h5 mb-0">Accounts</h2></div>
    <div class="card-body">
        <form method="get" class="d-flex gap-2 mb-3">
            <input asp-for="Search" class="form-control" placeholder="Search by name or email" />
            <button class="btn btn-primary" type="submit">Search</button>
        </form>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <p>Results for: @Html.Raw(Model.Search)</p>
        }
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead><tr><th>Username</th><th>Email</th><th>Phone</th><th>WUPHFs sent</th><th></th></tr></thead>
                <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Username</td><td>@user.Email</td><td>@user.PhoneNumber</td><td>@user.WuphfsSent</td>
                        <td><a asp-page-handler="Remove" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">Remove</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
